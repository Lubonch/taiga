# Maintainer: taiga-linux
pkgname=taiga-bin
_srcver=3.0.0-net10-preview.2
pkgver=${_srcver//-/_}
pkgrel=1
pkgdesc="Anime tracker de escritorio (backend .NET + Angular + Electron)"
arch=('x86_64')
url="https://github.com/Lubonch/taiga"
license=('GPL-3.0-or-later')
depends=('alsa-lib' 'gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'libutil-linux')
optdepends=('playerctl: detección MPRIS de reproductores')
source=("taiga-${_srcver}-linux-x64.tar.gz::https://github.com/Lubonch/taiga/releases/download/v${_srcver}/taiga-${_srcver}-linux-x64.tar.gz"
        "taiga.desktop")
sha256sums=('c742d204c4ce6d9636412cb0ef34318c9cca0172658932390867417cd14575b9'
            'e60e35b8ffe098627facdff9ae8ea625ae0ef27b4305f07b93d1211836f0a0b5')

package() {
  install -dm755 "$pkgdir/opt/taiga"
  cp -r "$srcdir/taiga-${_srcver}-linux-x64/"* "$pkgdir/opt/taiga/"
  install -Dm644 taiga.desktop "$pkgdir/usr/share/applications/taiga.desktop"
  install -dm755 "$pkgdir/usr/bin"
  ln -s /opt/taiga/taiga-shell "$pkgdir/usr/bin/taiga"
}
